# One settings file for every service. Copy it and fill in what you use:
#
#     cp .env.example .env
#
# ./run.sh starts each service that has its required values filled in and
# skips the rest; the gateway then reports skipped platforms as "disabled".
# Services also find this file when run on their own from their folder.
# Never commit .env.

# ── YouTube (youtube/) ────────────────────────────────────────────────────────
# Channel the gateway uploads to when a request doesn't send its own
# credentials. Get these with:
#   cd youtube && uv run python scripts/get_refresh_token.py client_secret.json
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Largest video the service downloads before uploading (bytes). Default 2 GiB.
YOUTUBE_MAX_VIDEO_BYTES=2147483648

# ── X / Twitter (x/) ──────────────────────────────────────────────────────────
# OAuth 1.0a keys from console.x.com. The app needs "Read and write"
# permission; generate the access token after setting it.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_API_BASE_URL=https://api.x.com
X_REQUEST_TIMEOUT=60
# 280 for regular accounts; raise only for X Premium.
X_MAX_POST_LENGTH=280
X_MAX_VIDEO_BYTES=536870912

# ── Telegram (bot/telegram/) ──────────────────────────────────────────────────
# Token from @BotFather. Add the bot as an admin with "Post messages" to each chat.
TELEGRAM_BOT_TOKEN=
# JSON array of chat ids or @usernames that receive every post.
TELEGRAM_CHAT_IDS=[]
# Optional: only this Telegram user may use the chat bot's /broadcast command.
TELEGRAM_OWNER_USER_ID=

# ── Facebook (meta_service/facebook/) ─────────────────────────────────────────
# Page access token with pages_manage_posts, pages_read_engagement,
# pages_show_list (and publish_video for videos).
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
FB_API_VERSION=v27.0
FB_API_BASE_URL=https://graph.facebook.com

# ── Instagram (meta_service/instagram/) ───────────────────────────────────────
# System User token with instagram_basic and instagram_content_publish.
IG_ACCESS_TOKEN=
# Instagram professional account id.
IG_USER_ID=
IG_API_VERSION=v27.0
IG_API_BASE_URL=https://graph.facebook.com

# ── Discord (bot/discord/) ────────────────────────────────────────────────────
# Bot token from discord.com/developers/applications → Bot → Reset Token.
DISCORD_BOT_TOKEN=
# JSON array of channel ids (Developer Mode → right-click channel → Copy Channel ID).
DISCORD_CHANNEL_IDS=[]
DISCORD_API_BASE_URL=https://discord.com/api/v10
DISCORD_REQUEST_TIMEOUT=30

# ── Gateway (gateway/) ────────────────────────────────────────────────────────
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# Where the gateway finds each service. ./run.sh uses these ports. An empty
# value disables that platform.
YOUTUBE_URL=http://127.0.0.1:8001
X_URL=http://127.0.0.1:8000
TELEGRAM_URL=http://127.0.0.1:8002
FACEBOOK_URL=http://127.0.0.1:8003
INSTAGRAM_URL=http://127.0.0.1:8004
DISCORD_URL=http://127.0.0.1:8005
# Seconds to wait per service. YouTube downloads and uploads within one call.
YOUTUBE_TIMEOUT=7200
DEFAULT_TIMEOUT=300
# Finished jobs kept in memory for GET /posts/{id}.
MAX_JOBS=1000
