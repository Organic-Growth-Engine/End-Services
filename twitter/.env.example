# OAuth 1.0a credentials from your app in the X Developer Console (console.x.com).
# The app needs "Read and write" permissions. Generate the access token and secret
# after setting that permission, or they stay read-only.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional.
X_API_BASE_URL=https://api.x.com
X_REQUEST_TIMEOUT=60

# 280 weighted characters for regular accounts. Raise only for X Premium accounts.
X_MAX_POST_LENGTH=280

# Largest video (bytes) the service will download before uploading. Default 512 MB.
X_MAX_VIDEO_BYTES=536870912
