# Required. Token from @BotFather.
BOT_TOKEN=123456789:replace-with-your-bot-token

# Optional. Telegram user id allowed to send commands to the bot.
# Leave empty to allow any private chat. Send /id to the bot to find yours.
OWNER_USER_ID=

# Required. JSON array of chat ids/usernames that receive each broadcast.
CHAT_IDS=["-1001111111111", "-1002222222222", "@my_channel"]
