{
  "info": {
    "name": "Twilio WhatsApp API",
    "description": "Local API collection for the Twilio WhatsApp integration. Start the server, expose it with ngrok, and set PUBLIC_BASE_URL to the ngrok HTTPS URL before sending media.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "recipient",
      "value": "+15551234567"
    },
    {
      "key": "businessNumber",
      "value": "whatsapp:+14155238886"
    },
    {
      "key": "messageSid",
      "value": ""
    },
    {
      "key": "inboundSid",
      "value": ""
    },
    {
      "key": "mediaUrl",
      "value": ""
    },
    {
      "key": "sampleMediaUrl",
      "value": "https://picsum.photos/600/400.jpg"
    },
    {
      "key": "sampleImagePath",
      "value": "samples/sample.jpg"
    },
    {
      "key": "sampleVideoPath",
      "value": "samples/sample.mp4"
    },
    {
      "key": "simSid",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response reports a healthy status', function () {",
                  "  pm.expect(body.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send text",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response contains a message SID', function () {",
                  "  pm.expect(body.message.sid).to.match(/^SM[0-9a-f]{32}$/i);",
                  "});",
                  "",
                  "if (body.message && body.message.sid) {",
                  "  pm.collectionVariables.set('messageSid', body.message.sid);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"{{recipient}}\",\n  \"body\": \"Hello from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/messages/text"
          }
        },
        {
          "name": "Get message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response contains the requested SID', function () {",
                  "  pm.expect(body.message.sid).to.eql(pm.collectionVariables.get('messageSid'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/messages/{{messageSid}}"
          }
        }
      ]
    },
    {
      "name": "Media",
      "item": [
        {
          "name": "Send image (upload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('An image was stored', function () {",
                  "  pm.expect(body.media.kind).to.eql('image');",
                  "});",
                  "",
                  "pm.test('The message reports the media URL', function () {",
                  "  pm.expect(body.message.mediaUrls).to.include(body.media.url);",
                  "});",
                  "",
                  "pm.collectionVariables.set('mediaUrl', body.media.url);",
                  "pm.collectionVariables.set('messageSid', body.message.sid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "to",
                  "value": "{{recipient}}",
                  "type": "text"
                },
                {
                  "key": "body",
                  "value": "Photo from Postman",
                  "type": "text"
                },
                {
                  "key": "file",
                  "src": "{{sampleImagePath}}",
                  "type": "file"
                }
              ]
            },
            "url": "{{baseUrl}}/api/messages/media"
          }
        },
        {
          "name": "Send video (upload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('A video was stored', function () {",
                  "  pm.expect(body.media.kind).to.eql('video');",
                  "});",
                  "",
                  "pm.collectionVariables.set('mediaUrl', body.media.url);",
                  "pm.collectionVariables.set('messageSid', body.message.sid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "to",
                  "value": "{{recipient}}",
                  "type": "text"
                },
                {
                  "key": "body",
                  "value": "Video from Postman",
                  "type": "text"
                },
                {
                  "key": "file",
                  "src": "{{sampleVideoPath}}",
                  "type": "file"
                }
              ]
            },
            "url": "{{baseUrl}}/api/messages/media"
          }
        },
        {
          "name": "Send media from URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('The message reports the hosted media URL', function () {",
                  "  pm.expect(body.message.mediaUrls).to.include(pm.collectionVariables.get('sampleMediaUrl'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('messageSid', body.message.sid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"{{recipient}}\",\n  \"mediaUrl\": \"{{sampleMediaUrl}}\",\n  \"body\": \"Media from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/messages/media-url"
          }
        }
      ]
    },
    {
      "name": "Inbound",
      "item": [
        {
          "name": "List inbound messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response contains a messages array', function () {",
                  "  pm.expect(body.messages).to.be.an('array');",
                  "});",
                  "",
                  "if (body.messages && body.messages.length > 0) {",
                  "  pm.collectionVariables.set('inboundSid', body.messages[0].sid);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/inbound-messages?limit=20"
          }
        },
        {
          "name": "Get inbound message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response contains the requested SID', function () {",
                  "  pm.expect(body.message.sid).to.eql(pm.collectionVariables.get('inboundSid'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/inbound-messages/{{inboundSid}}"
          }
        },
        {
          "name": "Simulate inbound message (dev)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hex = Array.from({ length: 32 }, function () {",
                  "  return Math.floor(Math.random() * 16).toString(16);",
                  "}).join('');",
                  "",
                  "pm.collectionVariables.set('simSid', 'SM' + hex);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('The simulated SID was stored', function () {",
                  "  pm.expect(body.message.sid).to.eql(pm.collectionVariables.get('simSid'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('inboundSid', body.message.sid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"MessageSid\": \"{{simSid}}\",\n  \"From\": \"whatsapp:+15551234567\",\n  \"To\": \"{{businessNumber}}\",\n  \"Body\": \"Simulated inbound message\",\n  \"NumMedia\": \"0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/dev/inbound"
          }
        }
      ]
    }
  ]
}
