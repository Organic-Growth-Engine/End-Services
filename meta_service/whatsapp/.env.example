# Server
PORT=3000
# URL that Twilio can reach. Twilio cannot fetch media or deliver webhooks to localhost.
# Local development: run `ngrok http 3000` and use the HTTPS URL, for example:
# PUBLIC_BASE_URL=https://abc123.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:3000

# Twilio credentials
# Account SID: Twilio Console > Account Info
# Auth Token: Twilio Console > Account Info
# WhatsApp number: the number shown in your WhatsApp trial/Sandbox setup
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Optional
TWILIO_VALIDATE_SIGNATURE=true
UPLOAD_TTL_MINUTES=60

# Inbound message persistence
INBOUND_STORE_FILE=data/inbound-messages.json
INBOUND_STORE_LIMIT=500

# Dev-only simulator endpoint (POST /api/dev/inbound).
# Enabled by default outside production. Set to false to disable.
# ENABLE_INBOUND_SIMULATOR=true

# Media limits in bytes (defaults: 5 MB image, 16 MB video, 20 MB total)
MAX_IMAGE_BYTES=5242880
MAX_VIDEO_BYTES=16777216
MAX_TOTAL_MEDIA_BYTES=20971520
