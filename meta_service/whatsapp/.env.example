# System user access token with whatsapp_business_messaging and
# whatsapp_business_management permissions.
WA_ACCESS_TOKEN=

# WhatsApp business phone number ID (used to send messages and upload media).
WA_PHONE_NUMBER_ID=

# WhatsApp Business Account / Messaging account ID (used to list templates).
WA_BUSINESS_ACCOUNT_ID=

# Graph API version to pin requests to.
WA_API_VERSION=v27.0

# API host.
WA_API_BASE_URL=https://graph.facebook.com
