# Business Integration System User access token (Instagram API with Unified Login). 
# Requires the instagram_basic and instagram_content_publish permissions.
IG_ACCESS_TOKEN=

# Instagram professional account ID.
IG_USER_ID=

# Graph API version to pin requests to.
IG_API_VERSION=v27.0

# API host. Unified Login uses the Facebook Graph API.
IG_API_BASE_URL=https://graph.facebook.com
