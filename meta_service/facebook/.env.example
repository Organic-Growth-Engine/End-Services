# Facebook Page access token. The token must have the pages_manage_posts,
# pages_read_engagement and pages_show_list permissions.
FB_PAGE_ACCESS_TOKEN=

# Facebook Page id that content is published to.
FB_PAGE_ID=

# Graph API version to pin requests to.
FB_API_VERSION=v27.0

# Graph API host.
FB_API_BASE_URL=https://graph.facebook.com
