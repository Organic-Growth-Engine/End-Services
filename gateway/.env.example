# Base URLs of the platform services. An empty value disables that platform.
YOUTUBE_URL=http://127.0.0.1:8001
X_URL=http://127.0.0.1:8000
TELEGRAM_URL=http://127.0.0.1:8002

# Seconds to wait for each service's response. YouTube downloads and uploads
# the whole video within one request, so it needs much longer.
YOUTUBE_TIMEOUT=7200
DEFAULT_TIMEOUT=300

# Finished jobs kept in memory for GET /posts/{id}; oldest are dropped first.
MAX_JOBS=1000

HOST=127.0.0.1
PORT=8080
